# AdoptIQ – secrets.env template (embed via embed_credentials.py; then build_pc.bat / build_mac_dmg.sh)
# Copy to secrets.env and fill in real values. Do not commit secrets.env.
# REQUIRED for Snowflake: Either (A) SNOWFLAKE_USER + SNOWFLAKE_ACCOUNT + SNOWFLAKE_PASSWORD, or (B) KEEPER_ROLE_ID + KEEPER_SECRET_ID + SNOWFLAKE_USER + SNOWFLAKE_ACCOUNT.

# --- Snowflake (REQUIRED for reports – config.py, adoptiq_backend) ---
# Option A: Direct password (recommended for embedded app)
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PASSWORD=
# Option B: Keeper auth – set KEEPER_ROLE_ID and KEEPER_SECRET_ID below
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- CircuIT (config.py, cisco_integration_config.py, adoptiq_backend) ---
# Supported models currently include (Round 73 / UX-3 + Round 77 / Build 53):
# - gemini-3.1-flash-lite  <-- AdoptIQ's default; the R69/R73 dropdown lists this first
# - gpt-5-nano             <-- supported alternative; one-click toggle in the preferences UI
# Deprecated / removal-soon models should not be used as defaults:
# - gpt-4o-mini
# - gpt-4.1
# - gpt-4o
CIRCUIT_API_KEY=
CIRCUIT_CLIENT_ID=
CIRCUIT_CLIENT_SECRET=
CIRCUIT_APP_KEY=
CIRCUIT_MODEL_NAME=gemini-3.1-flash-lite

# Round 69 / Build 43: per-call-site CircuIT model overrides.
# Both default to CIRCUIT_MODEL_NAME above when unset (back-compat).
# Resolution order at request time: settings.json (UI) > these env
# vars > CIRCUIT_MODEL_NAME > hardcoded fallback (gemini-3.1-flash-lite
# as of Round 77 / Build 53; was gpt-5-nano from R69 -> R76).
#
# WARNING: changing CIRCUIT_MODEL_NAME_REPORT affects the R27
# grounding-rejection rate -- the prompts are tuned against the
# default model, so flipping to a different model SHOULD be paired
# with a manual acceptance run (compare R27 rate from before/after).
# Use the operator-flippable UI toggle on the Analyze page (or the
# Admin Console settings tile) once the test ping passes; the
# settings.json value takes precedence over this env var without a
# restart.
#
# CIRCUIT_MODEL_NAME_ASK_AI is lower-risk -- the Ask AI path is
# eval-gated by tests/test_round66_p4_ask_ai_eval.py and does not
# block report generation, so a transient mismatch is recoverable.
CIRCUIT_MODEL_NAME_ASK_AI=
CIRCUIT_MODEL_NAME_REPORT=

# --- BST (app_simple.py, cisco_integration_config.py, cisco_internal_integrations.py) ---
BST_API_KEY=
BST_CLIENT_SECRET=
BST_ENABLE_WEB_SCRAPING=

# --- PSIRT (app_simple.py) ---
PSIRT_API_KEY=
PSIRT_CLIENT_SECRET=

# --- LLM fallback (cisco_internal_integrations.py) ---
ANTHROPIC_API_KEY=

# --- Flask (config.py, app_simple.py) ---
ADOPTIQ_SECRET_KEY=
SECRET_KEY=

# --- Admin dashboard (enhanced_admin_dashboard_v2.py) ---
# ADOPTIQ_ADMIN_SECRET_KEY is REQUIRED for packaged builds (app will not start without it).
ADOPTIQ_ADMIN_SECRET_KEY=
ADOPTIQ_MAIN_URL=http://localhost:5151

# --- Listening ports (Round 17.3) ---
# Defaults: 5151 (main app) / 5152 (admin dashboard).  Adjacent to the
# user's other 5150 app and outside the macOS AirPlay Receiver / Flask
# default 5000-5001 conflict zone.  Override at runtime if the defaults
# clash with another tool on your host (no rebuild required).
# ADOPTIQ_PORT=5151
# ADOPTIQ_ADMIN_PORT=5152

# --- CSOne OneDrive folder (optional) ---
# When no file is uploaded, use the most recent .xlsx from this folder.
# Round 17.2: AdoptIQ also auto-discovers the standard macOS / Windows
# OneDrive paths if this is left unset (e.g. ~/Library/CloudStorage/
# OneDrive-Cisco/AI Projects/AdoptIQ_CSOne_Reports on macOS).
# CSONE_ONEDRIVE_FOLDER=

# --- CSOne SharePoint pull (Round 17.2) ---
# When ADOPTIQ_SHAREPOINT_ENABLED=true, AdoptIQ will fetch the share
# below directly via Microsoft Graph (device-code OAuth) and ignore
# the OneDrive sync if it is missing.  Tokens are persisted in the
# macOS Keychain via the keyring library, with a 0600-permission
# JSON fallback in ~/.adoptiq/cache.  No secrets need to be embedded.
ADOPTIQ_SHAREPOINT_ENABLED=true
ADOPTIQ_SHAREPOINT_FOLDER_URL=https://cisco-my.sharepoint.com/:f:/r/personal/jestory_cisco_com/Documents/AI%20Projects/AdoptIQ_CSOne_Reports
# Optional overrides -- defaults are documented in config.py:
# ADOPTIQ_SHAREPOINT_CLIENT_ID=
# ADOPTIQ_SHAREPOINT_AUTHORITY=https://login.microsoftonline.com/common
# ADOPTIQ_SHAREPOINT_CACHE_DIR=
# ADOPTIQ_SHAREPOINT_MAX_FILE_BYTES=52428800

# --- Keeper (config.py – Mac app uses direct Snowflake; Keeper only for non-frozen dev) ---
KEEPER_URL=
KEEPER_NAMESPACE=
KEEPER_ROLE_ID=
KEEPER_SECRET_ID=
KEEPER_SECRET_PATH=
