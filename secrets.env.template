# AdoptIQ – secrets.env template (embed via embed_credentials.py; then build_pc.bat / build_mac_dmg.sh)
# Copy to secrets.env and fill in real values. Do not commit secrets.env.
# REQUIRED for Snowflake: Either (A) SNOWFLAKE_USER + SNOWFLAKE_ACCOUNT + SNOWFLAKE_PASSWORD, or (B) KEEPER_ROLE_ID + KEEPER_SECRET_ID + SNOWFLAKE_USER + SNOWFLAKE_ACCOUNT.

# --- Snowflake (REQUIRED for reports – config.py, adoptiq_backend) ---
# Option A: Direct password (recommended for embedded app)
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PASSWORD=
# Option B: Keeper auth – set KEEPER_ROLE_ID and KEEPER_SECRET_ID below
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- CircuIT (config.py, cisco_integration_config.py, adoptiq_backend) ---
CIRCUIT_API_KEY=
CIRCUIT_CLIENT_ID=
CIRCUIT_CLIENT_SECRET=
CIRCUIT_APP_KEY=
CIRCUIT_MODEL_NAME=gpt-4.1

# --- BST (app_simple.py, cisco_integration_config.py, cisco_internal_integrations.py) ---
BST_API_KEY=
BST_CLIENT_SECRET=
BST_ENABLE_WEB_SCRAPING=

# --- PSIRT (app_simple.py) ---
PSIRT_API_KEY=
PSIRT_CLIENT_SECRET=

# --- LLM fallback (cisco_internal_integrations.py) ---
ANTHROPIC_API_KEY=

# --- Flask (config.py, app_simple.py) ---
ADOPTIQ_SECRET_KEY=
SECRET_KEY=

# --- Admin dashboard (enhanced_admin_dashboard_v2.py) ---
# ADOPTIQ_ADMIN_SECRET_KEY is REQUIRED for packaged builds (app will not start without it).
ADOPTIQ_ADMIN_SECRET_KEY=
ADOPTIQ_MAIN_URL=http://localhost:5001

# --- CSOne OneDrive folder (optional) ---
# When no file is uploaded, use the most recent .xlsx from this folder.
# Default: %USERPROFILE%\OneDrive - Cisco\Documents\AI Projects\AdoptIQ_CSOne_Reports
# CSONE_ONEDRIVE_FOLDER=

# --- Keeper (config.py – Mac app uses direct Snowflake; Keeper only for non-frozen dev) ---
KEEPER_URL=
KEEPER_NAMESPACE=
KEEPER_ROLE_ID=
KEEPER_SECRET_ID=
KEEPER_SECRET_PATH=
