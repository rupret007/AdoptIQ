# Pin platform-specific script line endings so cross-platform commits
# (e.g. Mac contributor editing a .bat or PC contributor editing a .sh)
# do not corrupt the helper scripts shipped to end users.

# Windows-only scripts must be CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# macOS / Linux shell scripts must stay LF
*.command   text eol=lf
*.sh        text eol=lf

# Per-platform first-run instructions
scripts/win/READ_ME_FIRST.txt   text eol=crlf
scripts/mac/READ_ME_FIRST.txt   text eol=lf

# Treat known binary types as binary so git never attempts EOL conversion
*.dmg       binary
*.exe       binary
*.icns      binary
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.xlsx      binary
*.xlsm      binary
*.docx      binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
